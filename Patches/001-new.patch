-// Runtime A/B switch: GGML_CUDA_NO_TQ_PT=1 forces the old AoS path without a rebuild.
-static inline bool tq_pt_enabled() {
-    static const bool enabled = [] {
-        const char * e = getenv("GGML_CUDA_NO_TQ_PT");
-        return !(e && e[0] == '1');
-    }();
-    return enabled;
-}
