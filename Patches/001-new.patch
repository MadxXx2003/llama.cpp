-        }
-        // plane 2*s+1: elements 32s+16 .. 32s+31, weight words woff+4 .. woff+7
-#pragma unroll
-        for (int t = 0; t < 4; ++t) {
-            const int d4 = ggml_cuda_tq2_0_digits4(w[woff + 4 + t], shift);
-#pragma unroll
-            for (int j = 0; j < ncols_dst; ++j) {
-                sumi[j] = ggml_cuda_dp4a(d4, tq_pt_word(ahi[j], t), sumi[j]);
-            }
-        }
