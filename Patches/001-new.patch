+    static_assert(threads_per_row <= warp_size, "TQ2_0 MMQ needs at least one row per warp");
+    static_assert(threads_per_block*(QI8_0/2) == 2*MMQ_TILE_NE_K, "TQ2_0 tile row must hold QK_K bytes");
