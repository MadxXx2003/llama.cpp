+            sumi = ggml_cuda_dp4a(ggml_cuda_tq1_0_symbols4(b4, p0), get_int_b4(bq8_1_chunk->qs, j),     sumi);
+            sumi = ggml_cuda_dp4a(ggml_cuda_tq1_0_symbols4(b4, p1), get_int_b4(bq8_1_chunk->qs, 4 + j), sumi);
