diff --git a/ggml/src/ggml-cuda/dequantize.cuh b/ggml/src/ggml-cuda/dequantize.cuh
index 651524be7b3e..584b348c3e40 100644
--- a/ggml/src/ggml-cuda/dequantize.cuh
+++ b/ggml/src/ggml-cuda/dequantize.cuh
@@ -43,6 +43,23 @@ static __device__ __forceinline__ void dequantize_q2_0(const void * vx, const in
     v.y = (c1 - 1) * d;
 }
 
+// tq1_0: ternary weights, QK_K = 256 elements per block, ONE fp16 scale. The layout and the
+// multiply-free digit extraction live in ggml_cuda_tq1_0_symbol (common.cuh); the only multiply
+// here is by the block scale.
+//
+// qr == 1 contract of dequantize_block / k_get_rows: iqs = (i00 % qk)/qr IS the element index
+// (i00 = 2*threadIdx..., so iqs is even) and the caller stores v.x into element iqs and v.y into
+// element iqs + 1 -- exactly like dequantize_q2_0. Do NOT use 2*iqs here: that is the qr == 2
+// convention (v.x -> iqs, v.y -> iqs + qk/2) and would leave half of every block unwritten.
+static __device__ __forceinline__ void dequantize_tq1_0(const void * vx, const int64_t ib, const int iqs, float2 & v) {
+    const block_tq1_0 * x = (const block_tq1_0 *) vx;
+
+    const float d = x[ib].d;
+
+    v.x = ggml_cuda_tq1_0_symbol(x + ib, iqs + 0) * d;
+    v.y = ggml_cuda_tq1_0_symbol(x + ib, iqs + 1) * d;
+}
