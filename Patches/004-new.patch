From 1d5251bd5c80079b4bd2c4b91dc6031a691acaba Mon Sep 17 00:00:00 2001
From: LuzginDev <rostiknov@gmail.com>
Date: Wed, 4 Nov 2026 13:10:02 +0100
Subject: [PATCH 4/5] cuda : add HIP and MUSA fallbacks for byte permutation in
 TQ1_0

---
 ggml/src/ggml-cuda/common.cuh  | 12 ++++++------
 ggml/src/ggml-cuda/vecdotq.cuh | 14 ++++++++++++++
 2 files changed, 20 insertions(+), 6 deletions(-)

diff --git a/ggml/src/ggml-cuda/common.cuh b/ggml/src/ggml-cuda/common.cuh
index 7931f936217f..274b9bd563e0 100644
--- a/ggml/src/ggml-cuda/common.cuh
+++ b/ggml/src/ggml-cuda/common.cuh
@@ -1151,16 +1151,16 @@ static __device__ __forceinline__ int ggml_cuda_tq1_0_symbols4(const int b4, con
     const int dhi = (((whi & 0x00FF00FF) * 3) >> 8) & 0x00FF00FF;   // digits of bytes 1, 3
 
     // [digit0, digit1, digit2, digit3] as bytes, then the -1 bias for all four at once
-#if defined(GGML_USE_HIP)
-    // HIP has __vsub4 (ggml-cuda/vendors/hip.h) but no __byte_perm, so spell the 0x6240
+#if defined(GGML_USE_HIP) || defined(GGML_USE_MUSA)
+    // HIP and MUSA have __vsub4 but no __byte_perm, so spell the 0x6240
     // selector out with shifts and masks: byte0 = dlo.b0, byte1 = dhi.b0, byte2 = dlo.b2,
-    // byte3 = dhi.b2. Same result, two extra ALU ops, and only on the AMD path.
+    // byte3 = dhi.b2.
     const int merged = (dlo & 0x000000FF) | ((dhi & 0x000000FF) << 8)
                      | (dlo & 0x00FF0000) | ((dhi & 0x00FF0000) << 8);
     return __vsub4(merged, 0x01010101);
 #else
     return __vsub4(__byte_perm(dlo, dhi, 0x6240), 0x01010101);
-#endif // defined(GGML_USE_HIP)
+#endif // defined(GGML_USE_HIP) || defined(GGML_USE_MUSA)
 }
 
 // Raw ternary digits 0..2 (no -1 bias) of the four bytes of b4 at trit position n, one digit per
@@ -1196,13 +1196,13 @@ static __device__ __forceinline__ int ggml_cuda_tq1_0_digits4(const int b4, cons
     const int dlo = (((wlo & 0x00FF00FF) * 3) >> 8) & 0x00FF00FF;   // digits of bytes 0, 2
     const int dhi = (((whi & 0x00FF00FF) * 3) >> 8) & 0x00FF00FF;   // digits of bytes 1, 3
 
-#if defined(GGML_USE_HIP)
+#if defined(GGML_USE_HIP) || defined(GGML_USE_MUSA)
     const int merged = (dlo & 0x000000FF) | ((dhi & 0x000000FF) << 8)
                      | (dlo & 0x00FF0000) | ((dhi & 0x00FF0000) << 8);
     return merged;
 #else
     return __byte_perm(dlo, dhi, 0x6240);
-#endif // defined(GGML_USE_HIP)
+#endif // defined(GGML_USE_HIP) || defined(GGML_USE_MUSA)
 }
 
 // 3^n for the five trit positions of one TQ1_0 byte. Select chain: n is uniform per call but is
diff --git a/ggml/src/ggml-cuda/vecdotq.cuh b/ggml/src/ggml-cuda/vecdotq.cuh
index a9d6fe2a9d2d..a68c73d84ba8 100644
--- a/ggml/src/ggml-cuda/vecdotq.cuh
+++ b/ggml/src/ggml-cuda/vecdotq.cuh
@@ -856,8 +856,14 @@ static __device__ __forceinline__ float vec_dot_tq1_0_q8_1(
         }
 
         const int qh4  = get_int_b2(bq->qh, 0);
+#if defined(GGML_USE_HIP) || defined(GGML_USE_MUSA)
+        const uint32_t uqh4 = (uint32_t) qh4;
+        int       v_lo = (uqh4 & 0x000000FF) | ((uqh4 & 0x0000FF00) << 8); // qh[0], qh[1] in 16-bit lanes
+        int       v_hi = ((uqh4 >> 16) & 0x000000FF) | ((uqh4 >> 8) & 0x00FF0000); // qh[2], qh[3]
+#else
         int       v_lo = __byte_perm(qh4, 0, 0x4140); // qh[0], qh[1] in 16-bit lanes
         int       v_hi = __byte_perm(qh4, 0, 0x4342); // qh[2], qh[3]
+#endif
 
 #pragma unroll
         for (int t = 0; t < 4; ++t) {
@@ -866,7 +872,15 @@ static __device__ __forceinline__ float vec_dot_tq1_0_q8_1(
             v_lo = w_lo & 0x00FF00FF; // remainder carries to the next trit position
             v_hi = w_hi & 0x00FF00FF;
 
+#if defined(GGML_USE_HIP) || defined(GGML_USE_MUSA)
+            const uint32_t uw_lo = (uint32_t) w_lo;
+            const uint32_t uw_hi = (uint32_t) w_hi;
+            const int merged = ((uw_lo >> 8) & 0x000000FF) | ((uw_lo >> 16) & 0x0000FF00)
+                             | ((uw_hi << 8) & 0x00FF0000) | (uw_hi & 0xFF000000);
+            const int s4 = __vsub4(merged, 0x01010101);
+#else
             const int s4 = __vsub4(__byte_perm(w_lo, w_hi, 0x7531), 0x01010101);
+#endif
             sumi = ggml_cuda_dp4a(s4, get_int_b4(bq8_1_chunk->qs, 4 + t), sumi);
         }
     }

